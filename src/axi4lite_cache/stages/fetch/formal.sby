[options]
mode prove
depth 20

[engines]
smtbmc --syn --nopresat z3

[script]
read_slang --top fetch_stage -D FORMAL -I . \
  fetch_stage.sv \
  buffer.sv \
  arbiter.sv \
  cc_pkg.sv \
  cc_stream_fifo.sv \
  cc_fifo.sv

prep -top fetch_stage

